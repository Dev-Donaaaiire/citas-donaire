# ==============================================================================
# KRONO / DONAIRE CITAS - Variables de Entorno de Producción y Demo
# ==============================================================================

# 1. URL Pública de tu aplicación (obligatoria para emails, webhooks y OAuth/RSC)
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# 2. Supabase (Base de datos del negocio)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
# OBLIGATORIA en servidor para todas las operaciones seguras tras el endurecimiento RLS:
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# 3. Autenticación del Panel de Administración (/admin y /setup)
# Contraseña maestra para acceder al panel del dueño (mínimo 10 caracteres)
ADMIN_PASSWORD=cambia-esta-clave-maestra-segura
# Secreto HMAC-SHA256 obligatorio en producción (mínimo 16 caracteres, recomendado 32)
ADMIN_SESSION_SECRET=genera-un-secreto-largo-y-aleatorio-de-32-caracteres

# 4. Emails Transaccionales & Calendario (.ics) con Resend
# Nota: para enviar emails a cualquier cliente final, debes verificar tu dominio propio en Resend.
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM_EMAIL=Tu Negocio <citas@tudominio.com>
OWNER_NOTIFICATION_EMAIL=propietario@tudominio.com

# 5. Licencia Comercial y Activación de Producción (cuando modo_demo = false)
# NOTA IMPORTANTE PARA PRODUCCIÓN: En Supabase -> business_settings -> fija modo_demo = false
# para activar la seguridad real de clientes, ocultar la barra demo y exigir licencia activa.
LICENSE_KEY=DONAIRE-XXXX-XXXX-2027
# (Opcional) Endpoint remoto y secreto compartido para validar licencias contra tu servidor maestro
# LICENSE_VERIFY_API_URL=https://tu-master.vercel.app/api/license/verify
# LICENSE_VERIFY_SECRET=secreto-compartido-license-verify
# (Solo en el servidor maestro del vendedor):
# MASTER_SUPABASE_URL=https://master-proyecto.supabase.co
# MASTER_SUPABASE_SERVICE_ROLE_KEY=master_service_role_key

# 6. Modo de Visualización (Portal del Negocio vs Plataforma de Venta Comercial)
# Por defecto (sin definir o false): la raíz '/' es el portal de citas directo para los clientes del local.
# Define true ÚNICAMENTE en tu web oficial si estás usando esta instancia para vender licencias del software:
# NEXT_PUBLIC_SHOW_SALES_LANDING=true

# 7. Checkout / Pagos SaaS (Landing comercial - PayPal)
NEXT_PUBLIC_PAYPAL_URL_15=
NEXT_PUBLIC_PAYPAL_URL_99=
# Teléfono WhatsApp con prefijo internacional para dudas directas del plan Llave en Mano (ej. 34600000000)
NEXT_PUBLIC_SALES_WHATSAPP=

# Verificación criptográfica obligatoria del Webhook de PayPal
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_ENV=live

# 7. Enlaces y Metadatos Legales del Vendedor
NEXT_PUBLIC_REPO_URL=https://github.com/Dev-Donaaaiire/citas-donaire
NEXT_PUBLIC_TUTORIAL_VIDEO_URL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_NIF=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
