# ==============================================================================
# Krono / Donaire Citas - Variables de Entorno Requeridas (1-Click Vercel Deploy)
# ==============================================================================

# 1. Supabase del negocio (Settings -> API en tu proyecto Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key

# 2. Resend para correos automáticos con archivo .ics y recordatorios (+30 días)
RESEND_API_KEY=re_tu_api_key_aqui

# 3. Clave de licencia entregada tras tu compra (formato DONAIRE-XXXX-XXXX-2027)
LICENSE_KEY=DONAIRE-XXXX-XXXX-2027

# ==============================================================================
# Variables Opcionales (Personalización y Webhook de Ventas Stripe)
# ==============================================================================

# Remitente y correo de respaldo del dueño para notificaciones
RESEND_FROM_EMAIL="Krono / Donaire Citas <onboarding@resend.dev>"
OWNER_NOTIFICATION_EMAIL=reservas@donairecitas.pro

# Validación de licencia contra Supabase maestro o API central (opcional para copias de compradores)
# MASTER_SUPABASE_URL=https://tu-supabase-maestro.supabase.co
# MASTER_SUPABASE_ANON_KEY=tu-anon-key-maestro
# LICENSE_VERIFY_API_URL=https://tudominio.com/api/license/verify

# Webhook automático de Stripe (/api/webhooks/stripe) para emitir licencias tras el pago
# STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# Enlaces de entrega incluidos en el email de bienvenida tras la compra
# NEXT_PUBLIC_REPO_URL=https://github.com/donaire/krono-citas
# NEXT_PUBLIC_TUTORIAL_VIDEO_URL=https://www.youtube.com/watch?v=krono-donaire-setup-5min
