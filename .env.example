# ==============================================================================
# KRONO / DONAIRE CITAS - Variables de Entorno de Producción y Demo
# ==============================================================================

# 1. URL Pública de tu aplicación (obligatoria para emails, webhooks y OAuth/RSC)
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# 2. Supabase (Base de datos del negocio)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
# OBLIGATORIA en servidor para todas las operaciones seguras tras el endurecimiento RLS:
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Conexión Postgres para aplicar la base de datos al compilar. La integración Supabase
# de Vercel la crea sola (POSTGRES_URL_NON_POOLING); a mano, copia la cadena de
# Supabase -> Connect -> Session pooler.
# SUPABASE_DB_URL=postgresql://...
# SKIP_DB_MIGRATIONS=true

# 3. Autenticación del Panel de Administración (/admin y /setup)
# Contraseña maestra para acceder al panel del dueño (mínimo 10 caracteres)
ADMIN_PASSWORD=cambia-esta-clave-maestra-segura
# Opcional: si se deja vacío se deriva de ADMIN_PASSWORD + clave de servidor de Supabase
# ADMIN_SESSION_SECRET=

# 4. Emails Transaccionales & Calendario (.ics) con Resend
# Nota: para enviar emails a cualquier cliente final, debes verificar tu dominio propio en Resend.
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM_EMAIL=Tu Negocio <citas@tudominio.com>
OWNER_NOTIFICATION_EMAIL=propietario@tudominio.com

# Rutas públicas /demo: por defecto usan un sandbox aislado. Solo con 'true' (y
# modo_demo activo) leen y escriben en la base de datos real. No lo actives en producción.
ALLOW_PUBLIC_DEMO_DB=false

# 5. Página de presentación
# Por defecto (sin definir o false) la raíz '/' es el portal de citas de tu negocio.
# Define true solo en la web oficial de Krono, que presenta el proyecto:
# NEXT_PUBLIC_SHOW_SALES_LANDING=true

# 6. Datos que aparecen en /legal (responsable de los datos de tus clientes)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_EMAIL=
# Opcionales
NEXT_PUBLIC_LEGAL_NIF=
NEXT_PUBLIC_LEGAL_ADDRESS=
